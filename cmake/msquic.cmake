# Microsoft native MsQuic/OpenSSL; no global install or Schannel fallback.
set(FPS_MSQUIC_VERSION "2.6.3")
set(FPS_MSQUIC_ARCHIVE "${CMAKE_BINARY_DIR}/_deps/fps-msquic-2.6.3/package.nupkg")
set(FPS_MSQUIC_ROOT "${CMAKE_BINARY_DIR}/_deps/fps-msquic-2.6.3/content")
set(FPS_MSQUIC_ARCHIVE_SHA "41505c3861ef386c8788dd6d9e0ffea75b275b7d0651c2b940628ab729cf27bd")
set(FPS_MSQUIC_DLL "${FPS_MSQUIC_ROOT}/build/native/bin/x64/msquic.dll")
if(NOT EXISTS "${FPS_MSQUIC_ARCHIVE}")
  file(DOWNLOAD "https://api.nuget.org/v3-flatcontainer/microsoft.native.quic.msquic.openssl/2.6.3/microsoft.native.quic.msquic.openssl.2.6.3.nupkg"
    "${FPS_MSQUIC_ARCHIVE}" EXPECTED_HASH SHA256=${FPS_MSQUIC_ARCHIVE_SHA} TLS_VERIFY ON)
endif()
file(SHA256 "${FPS_MSQUIC_ARCHIVE}" archive_sha)
if(NOT archive_sha STREQUAL FPS_MSQUIC_ARCHIVE_SHA)
  message(FATAL_ERROR "MsQuic archive integrity check failed")
endif()
if(NOT EXISTS "${FPS_MSQUIC_DLL}")
  file(ARCHIVE_EXTRACT INPUT "${FPS_MSQUIC_ARCHIVE}" DESTINATION "${FPS_MSQUIC_ROOT}")
endif()
file(SHA256 "${FPS_MSQUIC_DLL}" dll_sha)
if(NOT dll_sha STREQUAL "290b6c8716ac09eea043913f86164e0b2f5096c666c9f1ca81c0c5c1864e1cb0")
  message(FATAL_ERROR "MsQuic native runtime integrity check failed")
endif()
add_library(fps_msquic_headers INTERFACE)
target_include_directories(fps_msquic_headers SYSTEM INTERFACE "${FPS_MSQUIC_ROOT}/build/native/include")
function(fps_copy_msquic_runtime target)
  add_custom_command(TARGET ${target} POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_if_different "${FPS_MSQUIC_DLL}" "$<TARGET_FILE_DIR:${target}>/msquic.dll")
endfunction()
